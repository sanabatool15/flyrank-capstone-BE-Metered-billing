# Copy to .env and fill in with real values. Never commit .env (see CLAUDE.md).
#
# `.env` is loaded automatically — by the app's Settings (src/config.py,
# via pydantic-settings' env_file) and by `docker compose up` (compose.yaml's
# env_file). No manual `source .env` or separate schema/migration step is
# needed: `docker compose up` builds the image, starts the container, and
# the app creates any missing DB tables against DATABASE_URL on startup.

# --- Supabase (Postgres + Auth) ------------------------------------------
# Settings -> Database -> Connection string (URI) in the Supabase dashboard.
# Supabase Postgres is wire-compatible Postgres, so this is a normal
# SQLAlchemy psycopg2 URL pointed at Supabase's host instead of localhost.
DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side only, never expose to clients

# Settings -> API -> JWT Settings -> JWT Secret. Used to verify the
# signature of Supabase Auth access tokens sent as the bearer token.
SUPABASE_JWT_SECRET=<jwt-secret>

# --- Stripe (test mode only, per CLAUDE.md) -------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
